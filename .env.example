# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# GOOGLE AUTHENTICATION (Google Identity Services / OAuth 2.0)
# ==========================================
# Obtén tu Client ID en Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=""

# ==========================================
# GOOGLE ANALYTICS (GA4)
# ==========================================
# ID de medición de Google Analytics 4 (ejemplo: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=""

# ==========================================
# CONFIGURACIÓN DE ALMACENAMIENTO (STORAGE ADAPTER)
# ==========================================
# Opciones soportadas: 'local' | 'supabase' | 'firebase' | 's3' | 'custom_api'
VITE_STORAGE_PROVIDER="local"

# Si usas Supabase Storage:
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_SUPABASE_BUCKET="camt-statements"

# Si usas AWS S3 / Cloudflare R2 / MinIO:
VITE_S3_ENDPOINT=""
VITE_S3_BUCKET=""
VITE_S3_REGION="us-east-1"
VITE_S3_ACCESS_KEY_ID=""
VITE_S3_SECRET_ACCESS_KEY=""

# Si usas Firebase Storage:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
